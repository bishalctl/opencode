#!/usr/bin/env bash
# Fork desktop (Electron, unpackaged dev build).
#   Identity  ai.opencode.desktop.dev (own userData + single-instance lock, separate from upstream's ai.opencode.desktop)
#   Server    isolated daemon built from this worktree; registration lives in the desktop's userData
#   Data      shares opencode.db with upstream and `ocb`
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/env.sh"

# packages/desktop/scripts/dev.ts forces the `local` channel, which would otherwise pick opencode-local.db.
export OPENCODE_DB=opencode.db
# Don't steal the opencode:// handler from the upstream desktop.
export OPENCODE_DESKTOP_DISABLE_PROTOCOL_REGISTRATION=1

# NixOS can't run npm's prebuilt Electron. electron-vite honors ELECTRON_EXEC_PATH, so use a
# Nix-built Electron with the same major version as the desktop's pin (native modules are built
# against that ABI). The nixpkgs pinned for /etc/nixos's opencode-v2-desktop provides one.
if [ -e /etc/NIXOS ] && [ -z "${ELECTRON_EXEC_PATH:-}" ]; then
  major="$(sed -n 's/.*"electron": "\([0-9]*\)\..*/\1/p' "$OCB_REPO/packages/desktop/package.json")"
  ELECTRON_EXEC_PATH="$(ls -d /nix/store/*-electron-"$major".*/bin/electron 2>/dev/null | sort -V | tail -1)"
  if [ -z "$ELECTRON_EXEC_PATH" ]; then
    echo "ocb-desktop: no Nix-built Electron $major.x in /nix/store; build one or set ELECTRON_EXEC_PATH" >&2
    exit 1
  fi
  export ELECTRON_EXEC_PATH
fi

exec bun run --cwd "$OCB_REPO/packages/desktop" dev "$@"
